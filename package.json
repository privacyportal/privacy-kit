{
  "name": "@privacyportal.org/privacy-kit",
  "version": "0.1.0",
  "type": "module",
  "description": "Lightweight and FOSS browser library bringing Privacy Portal features to your website users",
  "main": "./dist/privacy-kit.cjs.js",
  "module": "./dist/privacy-kit.es.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/privacy-kit.es.js",
      "require": "./dist/privacy-kit.cjs.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "types"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "prebuild": "tsc --emitDeclarationOnly",
    "build": "tsc --noEmit && vite build --mode production",
    "prepublishOnly": "npm run build",
    "preview": "vite preview --open /test/signup.html",
    "lint:debug": "eslint --print-config eslint.config.mjs",
    "lint": "eslint src",
    "format": "eslint src --fix",
    "test:server": "vite preview --port 8800",
    "pretest": "npx playwright install --with-deps",
    "test": "npx playwright test",
    "test:interactive": "npx playwright test --ui"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/privacyportal/privacy-kit.git"
  },
  "author": "Privacy Portal",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/privacyportal/privacy-kit/issues"
  },
  "homepage": "https://github.com/privacyportal/privacy-kit#readme",
  "keywords": [
    "privacy",
    "email-alias",
    "privacy-alias",
    "hide-my-email",
    "subscribe-anonymously"
  ],
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.13.14",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-banner": "^0.8.0",
    "vite-plugin-dts": "^4.5.0"
  }
}
